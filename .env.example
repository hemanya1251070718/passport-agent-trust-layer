# ==============================================================================
# PASSPORT: AGENT TRUST & CONTROL LAYER - ENVIRONMENT TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER COMMIT REAL KEYS, TOKENS, OR CREDENTIALS TO THE PUBLIC REPOSITORY.
# IN CLOUD RUN PRODUCTION, SECRETS ARE INJECTED VIA GOOGLE CLOUD SECRET MANAGER.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # 'development' | 'staging' | 'production'
PORT=8000                              # Backend service port
FRONTEND_PORT=3000                     # Frontend dashboard port
API_BASE_URL=http://localhost:8000     # Backend public / internal origin
FRONTEND_URL=http://localhost:3000     # Frontend origin for CORS whitelist
LOG_LEVEL=info                         # 'debug' | 'info' | 'warn' | 'error'

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id     # Google Cloud project ID
GCP_REGION=asia-south1                 # Deployment region (e.g., asia-south1 Mumbai)
GOOGLE_APPLICATION_CREDENTIALS=        # Path to local service account json (leave empty if using gcloud auth ADC)

# ------------------------------------------------------------------------------
# 3. FIREBASE / IDENTITY PLATFORM (AUTH & RBAC)
# ------------------------------------------------------------------------------
# Frontend Firebase Client SDK keys
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Backend Firebase Admin SDK
FIREBASE_PROJECT_ID=your-gcp-project-id

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE (FIRESTORE)
# ------------------------------------------------------------------------------
FIRESTORE_DATABASE_ID=(default)        # Firestore database instance identifier

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC SIGNING & VERIFICATION (AGENT DELEGATION TOKENS)
# ------------------------------------------------------------------------------
# In production, Cloud KMS asymmetric signing is used.
# In local development, an Ed25519 / RS256 private key can be used.
PASSPORT_SIGNING_ALGORITHM=Ed25519     # 'Ed25519' | 'RS256'
PASSPORT_PRIVATE_KEY_PEM=              # Local private key PEM (if not using Cloud KMS)
PASSPORT_PUBLIC_KEY_PEM=               # Local public key PEM for verification endpoint
KMS_KEY_RING=passport-keyring          # Google Cloud KMS Keyring (production)
KMS_KEY_NAME=passport-signing-key      # Google Cloud KMS Key Name
KMS_KEY_VERSION=1                      # Google Cloud KMS Key Version

# ------------------------------------------------------------------------------
# 6. PARTNER APIS & CREDENTIALS
# ------------------------------------------------------------------------------
# Olostep API (Web search, scraping & crawling API for governed agent research)
# Get your free 5,000 credits promo code from Homingo Hack Days dashboard
OLOSTEP_API_KEY=your_olostep_api_key

# Crustdata API (Company-level verification & vendor risk intelligence)
# 5,000+ credits claimable on Homingo Hack Days dashboard (Expires Dec 6, 2026)
CRUSTDATA_API_KEY=your_crustdata_api_key

# n8n Integration (Workflow automation for human approval webhooks)
# Captain claims free 1-month n8n Cloud Pro coupon from Hack Days dashboard
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/agent-approval
N8N_API_KEY=your_n8n_api_key

# Bitsbee Ops (MCP-native mobile control plane for card-based human approvals)
BITSBEE_OPS_API_KEY=your_bitsbee_ops_api_key
BITSBEE_OPS_WORKSPACE_ID=your_bitsbee_workspace_id

# ------------------------------------------------------------------------------
# 7. RED-TEAM EVAL HARNESS & SIMULATION MODES
# ------------------------------------------------------------------------------
SIMULATED_WALLET_ENABLED=true          # Always true: Sandboxed simulated ledger
MERCHANT_SANDBOX_STRICT_MODE=true      # Enforce merchant allowlist & risk threshold
EVAL_DETERMINISTIC_SEED=42             # Seed for repeatable red-team evaluation runs
